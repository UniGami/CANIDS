  "smooth_eps": 0.03,
  "smooth_min_change": 0.02,
  "smooth_lookahead_ticks": 360,
  "branch2_min_share": 0.25,
  "refine": null,
  "notes": "The TCN trained on train_1 only, with the GRU's detector settings (untuned). Kept to reproduce the numbers in docs/14."
