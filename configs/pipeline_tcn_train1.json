{
  "name": "tcn-train1 (older TCN, GRU's settings)",
  "forecaster": "tcn",
  "model_path": "models/tcn_syncan_train1.pt",
  "calibration": [
    {
      "csv": "data/raw/syncan_train_2_long.csv",
      "cache": "train2L"
    },
    {
      "csv": "data/raw/syncan_train_3_long.csv",
      "cache": "train3L"
    }
  ],
  "relational_model": "models/relational_syncan_train1.json",
