# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Environments
.venv/
venv/
env/
.conda/

# Data
data/raw/
data/processed/
data/synthetic/*
!data/synthetic/.gitkeep

# Real SynCAN distribution archive -- large (~380MB), not project source.
# Keeping it out of src/canids/ long-term and moving it under data/raw/
# (already ignored above) is recommended, but this rule covers it wherever
# it currently sits.
SynCAN-master.zip
src/canids/SynCAN-master.zip
results.txt

# Generated analysis caches (residual / evidence arrays, 17-380MB each) -- reproducible with
# scripts/sweep_signed_floor.py collect and scripts/diagnose_false_alerts.py collect. A single file over
# 100MB is rejected by GitHub, and pushes this large time out (HTTP 408).
*.npz
logs/sweep/
logs/diag/
report

# Caches / tooling
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
